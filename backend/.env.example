# Backend Server Port
PORT=5000

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/farm_management?retryWrites=true&w=majority

# JWT Secret & Expiration
JWT_SECRET=your_long_random_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=7d

# Frontend Application URL (for CORS and cookies)
CLIENT_URL=http://localhost:5173

# Node Environment (development | production)
NODE_ENV=development

# Weather API Credentials (OpenWeatherMap)
WEATHER_API_KEY=
WEATHER_API_URL=https://api.openweathermap.org/data/2.5

# Google Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
